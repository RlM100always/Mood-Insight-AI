{
  "expo": {
    "name": "Mood Insight AI",
    "slug": "mood-insight-native",
    "scheme": "moodinsight",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.moodinsight.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "app.moodinsight.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "versionCode": 4
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "extra": {
      "appPurpose": "private-offline-wellbeing"
    },
    "updates": {
      "enabled": false
    }
  }
}
