{
  "name": "mood-insight-native",
  "version": "0.5.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "bundle:android": "expo export --platform android --output-dir dist",
    "bundle:ios": "expo export --platform ios --output-dir dist-ios",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "expo": "~58.0.11",
    "expo-crypto": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "@noble/ciphers": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-sharing": "~58.0.20"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "braces": "^3.0.3",
    "node-forge": "^1.3.2"
  }
}
